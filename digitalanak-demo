<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>digitalanak-demo - Karyawan Digital untuk Belajar Anak</title>
<style>
  :root {
    --bg: #0b0d12;
    --card: #141821;
    --line: #232a38;
    --text: #e8ebf2;
    --muted: #8b93a7;
    --accent: #5eead4;
    --accent2: #fbbf24;
    --bad: #f87171;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
  }
  section { max-width: 960px; margin: 0 auto; padding: 56px 20px; }
  h2 { font-size: 1.6rem; margin-bottom: 8px; letter-spacing: -0.02em; }
  .sub { color: var(--muted); margin-bottom: 28px; }

  /* HERO */
  .hero { text-align: center; padding-top: 80px; }
  .avatar {
    width: 88px; height: 88px; border-radius: 24px; margin: 0 auto 20px;
    display: flex; align-items: center; justify-content: center;
    font-size: 44px; background: var(--card); border: 1px solid var(--line);
    box-shadow: 0 0 40px rgba(94, 234, 212, 0.15);
  }
  .badge {
    display: inline-block; padding: 6px 14px; border-radius: 999px;
    background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.3);
    color: var(--accent); font-size: 0.85rem; margin-bottom: 20px;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 6vw, 3rem); letter-spacing: -0.03em; margin-bottom: 12px;
  }
  .hero h1 span { color: var(--accent); }
  .hero p { color: var(--muted); font-size: 1.1rem; max-width: 520px; margin: 0 auto 28px; }

  /* BUTTONS */
  .btn {
    display: inline-block; padding: 13px 26px; border-radius: 12px;
    text-decoration: none; font-weight: 600; font-size: 0.95rem;
    transition: transform 0.15s, box-shadow 0.15s; cursor: pointer; border: none;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: var(--accent); color: #062b27; box-shadow: 0 6px 24px rgba(94, 234, 212, 0.25); }
  .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }

  /* PROBLEM VS SOLUTION */
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .box { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .box h3 { font-size: 1.05rem; margin-bottom: 14px; }
  .box.chaos h3 { color: var(--bad); }
  .box.solution h3 { color: var(--accent); }
  .box ul { list-style: none; }
  .box li { padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.95rem; }
  .box li:last-child { border-bottom: none; }
  .box.chaos li::before { content: "✕  "; color: var(--bad); }
  .box.solution li::before { content: "✓  "; color: var(--accent); }

  /* CAPABILITIES */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cap { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .cap .ic { font-size: 28px; margin-bottom: 12px; }
  .cap h3 { font-size: 1.05rem; margin-bottom: 8px; }
  .cap p { color: var(--muted); font-size: 0.92rem; }

  /* CHAT SIMULATION */
  .chat { background: var(--card); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; max-width: 640px; margin: 0 auto; }
  .chat-head { padding: 14px 18px; border-bottom: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .chat-body { height: 320px; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .msg { max-width: 82%; padding: 10px 14px; border-radius: 14px; font-size: 0.93rem; animation: pop 0.25s ease; white-space: pre-line; }
  .msg.user { align-self: flex-end; background: var(--accent); color: #062b27; border-bottom-right-radius: 4px; }
  .msg.bot { align-self: flex-start; background: #1d2330; border-bottom-left-radius: 4px; }
  .typing { display: flex; gap: 4px; padding: 14px; }
  .typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: blink 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: 0.2s; }
  .typing i:nth-child(3) { animation-delay: 0.4s; }
  .hint { color: var(--muted); text-align: center; margin: auto; font-size: 0.9rem; }
  .scenarios { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 18px; border-top: 1px solid var(--line); }
  .scenarios button {
    flex: 1 1 180px; background: transparent; color: var(--text); border: 1px solid var(--line);
    padding: 10px 12px; border-radius: 10px; font-size: 0.85rem; cursor: pointer; transition: border-color 0.15s;
  }
  .scenarios button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .scenarios button:disabled { opacity: 0.4; cursor: not-allowed; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.25; } 40% { opacity: 1; } }

  /* FOOTER */
  footer { text-align: center; border-top: 1px solid var(--line); }
  footer h2 { margin-bottom: 10px; }
  footer .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin: 22px 0 36px; }
  footer small { color: var(--muted); }

  @media (max-width: 720px) {
    .compare, .cards { grid-template-columns: 1fr; }
    section { padding: 40px 16px; }
    .hero { padding-top: 56px; }
  }
</style>
</head>
<body>

<!-- 1. HERO -->
<section class="hero">
  <div class="avatar">🧸</div>
  <div class="badge">🟢 Status: Active &amp; Ready 24/7</div>
  <h1><span>DIGITALANAK-DEMO</span></h1>
  <p>Membantu anak-anak belajar dengan mudah dan ceria.</p>
  <a class="btn btn-primary" href="#simulasi">Coba Simulasi</a>
</section>

<!-- 2. PROBLEM & SOLUTION -->
<section>
  <h2>Dari Bingung Jadi Terarah</h2>
  <p class="sub">Masalah yang sering dihadapi orangtua, dan cara kami menyelesaikannya.</p>
  <div class="compare">
    <div class="box chaos">
      <h3>The Chaos</h3>
      <ul>
        <li>Anak sering susah disuruh belajar</li>
        <li>Kalau HP diambil, anak jadi tantrum</li>
        <li>Anak kurang fokus makan kalau tidak pakai HP</li>
        <li>Tidak ada jadwal pembelajaran di rumah</li>
        <li>Orangtua bingung harus mulai dari mana</li>
      </ul>
    </div>
    <div class="box solution">
      <h3>The Solution</h3>
      <ul>
        <li>Menyusun jadwal belajar anak di rumah bersama orangtua</li>
        <li>Menyediakan tempat belajar dengan materi yang tidak membosankan</li>
        <li>Membuat orangtua tenang dengan tontonan anak yang terkurasi</li>
        <li>Langkah jelas harian, orangtua tidak perlu menebak-nebak</li>
        <li>Anak belajar dengan ceria, bukan karena dipaksa</li>
      </ul>
    </div>
  </div>
</section>

<!-- 3. CORE CAPABILITIES -->
<section>
  <h2>Kemampuan Utama</h2>
  <p class="sub">Tiga hal yang dikerjakan assistant ini untuk keluarga Anda.</p>
  <div class="cards">
    <div class="cap">
      <div class="ic">🗓️</div>
      <h3>Jadwal Belajar Rumah</h3>
      <p>Membantu orangtua menyusun rutinitas belajar anak yang realistis dan mudah diikuti setiap hari.</p>
    </div>
    <div class="cap">
      <div class="ic">🎨</div>
      <h3>Ruang Belajar Seru</h3>
      <p>Tempat belajar dengan materi yang tidak membosankan, dibuat supaya anak mau belajar sendiri.</p>
    </div>
    <div class="cap">
      <div class="ic">🛡️</div>
      <h3>Tontonan Lebih Aman</h3>
      <p>Orangtua tidak lagi khawatir dengan apa yang ditonton anak saat memegang HP.</p>
    </div>
  </div>
</section>

<!-- 4. INTERACTIVE SIMULATION -->
<section id="simulasi">
  <h2>Simulasi Percakapan</h2>
  <p class="sub">Pilih satu skenario dan lihat bagaimana assistant merespons.</p>
  <div class="chat">
    <div class="chat-head"><span class="dot"></span> digitalanak-demo · online</div>
    <div class="chat-body" id="chatBody">
      <div class="hint" id="hint">Pilih skenario di bawah untuk memulai 👇</div>
    </div>
    <div class="scenarios">
      <button data-s="0">😩 Anak susah disuruh belajar</button>
      <button data-s="1">😭 Anak tantrum saat HP diambil</button>
      <button data-s="2">🍚 Anak makan harus pakai HP</button>
    </div>
  </div>
</section>

<!-- 5. FOOTER & CTA -->
<footer>
  <section>
    <h2>Siap Bikin Belajar Anak Jadi Menyenangkan?</h2>
    <p class="sub">Hubungi kami atau lihat langsung produk digitalnya.</p>
    <div class="actions">
      <a class="btn btn-primary" href="https://wa.me/6285129882829" target="_blank" rel="noopener">💬 Chat via WhatsApp</a>
      <a class="btn btn-ghost" href="https://lynk.id/zulnandigipreneur" target="_blank" rel="noopener">🔗 Lihat Produk</a>
    </div>
    <small>Built with AI · AI Builder Bootcamp Showcase</small>
  </section>
</footer>

<script>
  const scenarios = [
    {
      user: "Anak saya umur 5 tahun susah banget disuruh belajar. Harus gimana?",
      bot: "Tenang, Bu/Pak, ini sangat umum 😊\n\nCoba mulai kecil:\n• 15 menit belajar, jam yang sama tiap hari\n• Pakai materi bergambar yang seru, bukan lembar kosong\n• Beri bintang untuk setiap sesi selesai\n\nMau saya susunkan jadwal belajar mingguannya?"
    },
    {
      user: "Kalau HP diambil, anak saya langsung tantrum. Bingung saya.",
      bot: "Itu wajar, karena HP terasa menyenangkan bagi anak. Jangan diambil tiba-tiba ya.\n\n• Kasih peringatan 5 menit sebelum waktu habis\n• Siapkan kegiatan pengganti yang seru (cerita bergambar, mewarnai)\n• Alihkan HP dari hiburan ke ruang belajar yang ceria\n\nSaya bisa rekomendasikan materi pengganti yang cocok untuk usianya."
    },
    {
      user: "Anak saya nggak mau makan kalau nggak sambil nonton HP.",
      bot: "Banyak orangtua mengalami ini. Dua langkah awal:\n• Mulai dengan waktu makan bebas layar, bertahap 1 kali sehari\n• Untuk transisi, pilih tontonan edukatif yang sudah dikurasi\n\nDengan begitu Anda tidak perlu khawatir dengan apa yang ditonton anak. Mau saya buatkan rutinitas makan yang lebih fokus?"
    }
  ];

  const body = document.getElementById("chatBody");
  const buttons = document.querySelectorAll(".scenarios button");
  const wait = ms => new Promise(r => setTimeout(r, ms));

  function addMsg(text, who) {
    const el = document.createElement("div");
    el.className = "msg " + who;
    el.textContent = text;
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
  }

  function showTyping() {
    const el = document.createElement("div");
    el.className = "msg bot typing";
    el.innerHTML = "<i></i><i></i><i></i>";
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
    return el;
  }

  async function run(index) {
    buttons.forEach(b => b.disabled = true);
    body.innerHTML = "";
    const s = scenarios[index];
    await wait(300);
    addMsg(s.user, "user");
    await wait(500);
    const t = showTyping();
    await wait(1600);
    t.remove();
    addMsg(s.bot, "bot");
    buttons.forEach(b => b.disabled = false);
  }

  buttons.forEach(b => b.addEventListener("click", () => run(Number(b.dataset.s))));
</script>
</body>
</html>
